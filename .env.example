# Copy to .env and fill in real values. Never commit .env itself.

VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
EVERLY_ASSISTANT_ID=

# `npx tsx src/assistant/create.ts` pushes THIS value to Vapi for both the
# assistant-level webhook and every individual tool's server.url. Point it at
# whatever should currently receive real tool-call webhooks (the deployed
# server's public URL once live, or an ngrok tunnel during local-only
# testing) — running that command with the wrong value here will SILENTLY
# repoint every tool's webhook, breaking submit_quote/etc. on real calls
# without any error until someone checks. Confirmed root cause of a real
# incident (2026-07-25): several voice/prompt-only assistant pushes each
# re-read this from a stale local value and quietly reverted every tool's
# webhook back to a dead ngrok tunnel, so submitted quotes never arrived
# anywhere. Double-check this value before every assistant:create push once
# an environment is live — this also matters now that dev and production
# share this same Vapi assistant: whichever environment last ran
# assistant:create decides where ALL live tool-calls route, for both.
ORCHESTRATION_WEBHOOK_URL=

MONGODB_URI=

# MDR's real Voice API (staging) — no mock service exists anymore.
MDR_API_BASE_URL=https://staging.mydrayrate.com/api
MDR_API_KEY=

# Declared but not currently enforced — POST /webhooks/mdr/capture has no
# auth check yet (MDR's real signing/auth scheme for this webhook isn't
# confirmed). Set it anyway so it's ready once that's wired up.
MDR_WEBHOOK_SECRET=

PORT=3000

# Calling window (carrier's local time zone) — confirmed client rule:
# Mon-Fri, 8 AM-5 PM. Sometimes temporarily widened for live testing (e.g.
# all 7 days, 0-24) — always confirm which is currently set before trusting
# a dispatch run to reflect real calling hours.
CALLING_WINDOW_DAYS=Mon,Tue,Wed,Thu,Fri
CALLING_WINDOW_START_HOUR=8
CALLING_WINDOW_END_HOUR=17

# Shared secret MDR (or anyone testing) must send as the x-api-key header on
# POST /test/dispatch (the on-demand testing endpoint that lets a real
# load+carriers be dialed immediately, bypassing cadence/dispatch scheduling
# but not the real calling-window/threshold/stop_call checks),
# POST /webhooks/mdr/capture, and POST /webhooks/mdr/update-flags. Requests
# without a matching key are rejected with 401.
TEST_DISPATCH_API_KEY=
